#!/usr/bin/env python
from misc.utility.scons_hints import *

import sys
from pathlib import Path

Import("env")

env.add_source_files(env.scene_sources, "*.cpp")

if not env.editor_build:
    content_root = Path(Dir("#editor/content").abspath)
    sys.path[:0] = [str(content_root), str(content_root / "assets")]
    import asset_builders
    import content_builders

    resources, support = content_builders.discover_content(asset_builders.discover_files(content_root), content_root)
    format_header = File("#scene/resources/resource_format_text.h")
    env_theme = env.Clone()
    env_theme["editor_content_root"] = str(content_root)
    env_theme["editor_content_resources"] = [str(path) for path in resources]
    env_theme["editor_content_support"] = [str(path) for path in support]
    env_theme["editor_content_shared_buffers"] = {}
    env_theme["resource_text_format_header"] = format_header.abspath
    env_theme["runtime_theme_entry"] = "res://.content/resources/themes/default.tres"

    theme_data = env_theme.CommandNoCache(
        ["runtime_theme_resources.gen.h", "runtime_theme_resources.gen.cpp"],
        [File(str(path)) for path in resources + support] + [format_header, env_theme.Value(env_theme["runtime_theme_entry"])],
        env_theme.Run(content_builders.make_content_resources),
    )
    env_theme.Depends(theme_data, [File("#editor/content/content_builders.py"), File("#editor/content/assets/asset_builders.py")])
    env_theme.add_source_files(env.scene_sources, [theme_data[1]])
