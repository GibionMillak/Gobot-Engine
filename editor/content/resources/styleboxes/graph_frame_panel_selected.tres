[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "GraphFrame panel_selected"
background_color = Color(0.0, 0.0, 0.0, 0.2)
border_color = "((((theme.default_base_color.get_luminance() < 0.5))) ? Color(1, 1, 1) : Color(0, 0, 0))"
border_width_bottom = "pixels(int(int((2 * max(1, theme.default_base_scale)))))"
border_width_left = "pixels(int(int((2 * max(1, theme.default_base_scale)))))"
border_width_right = "pixels(int(int((2 * max(1, theme.default_base_scale)))))"
border_width_top = "pixels(int(int((2 * max(1, theme.default_base_scale)))))"
corner_detail = "pixels(int(ceil(((0.8 * int(round((7 * theme.default_base_scale)))) * theme.default_base_scale))))"
corner_radius_bottom_left = "pixels(int((int(round((7 * theme.default_base_scale))) * theme.default_base_scale)))"
corner_radius_bottom_right = "pixels(int((int(round((7 * theme.default_base_scale))) * theme.default_base_scale)))"
corner_radius_top_left = "pixels(int((int(round((7 * theme.default_base_scale))) * theme.default_base_scale)))"
corner_radius_top_right = "pixels(int((int(round((7 * theme.default_base_scale))) * theme.default_base_scale)))"
expand_margin_top = "pixels(round((38 * theme.default_base_scale)))"
padding_bottom = "pixels((int(2) * theme.default_base_scale))"
padding_left = "pixels((int(2) * theme.default_base_scale))"
padding_right = "pixels((int(2) * theme.default_base_scale))"
padding_top = "pixels((int(2) * theme.default_base_scale))"
shadow_color = "Color(theme.Editor.colors.shadow_color, ((theme.Editor.colors.shadow_color).a * 0.25))"
shadow_size = "pixels(int(round((8 * theme.default_base_scale))))"
