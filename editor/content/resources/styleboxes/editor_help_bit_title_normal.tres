[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "EditorHelpBitTitle normal"
background_color = "((((theme.default_base_color.get_luminance() < 0.5))) ? ((theme.Editor.colors.dark_color_1).lerp(theme.Editor.colors.dark_color_2, 0.5)).lightened(0.04) : ((theme.Editor.colors.dark_color_1).lerp(theme.Editor.colors.dark_color_2, 0.5)).darkened(0.04))"
border_color = "((((theme.default_base_color.get_luminance() < 0.5))) ? (theme.Editor.colors.dark_color_3).lightened(0.04) : (theme.Editor.colors.dark_color_3).darkened(0.04))"
border_width_bottom = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_left = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_right = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_top = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
corner_detail = 8
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0
corner_radius_top_left = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_top_right = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
padding_bottom = "pixels((theme.default_padding * theme.default_base_scale))"
padding_left = "pixels((theme.default_padding * theme.default_base_scale))"
padding_right = "pixels((theme.default_padding * theme.default_base_scale))"
padding_top = "pixels((theme.default_padding * theme.default_base_scale))"
shadow_color = "theme.default_shadow_color"
