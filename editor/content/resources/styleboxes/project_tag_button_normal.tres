[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "ProjectTagButton normal"
background_color = "((((theme.default_base_color.get_luminance() < 0.5))) ? (theme.default_background_color).lightened(0.2) : (theme.default_background_color).darkened(0.2))"
border_color = "theme.default_border_color"
border_width_bottom = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_left = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_right = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_top = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
corner_detail = 8
corner_radius_bottom_left = 0
corner_radius_bottom_right = 4
corner_radius_top_left = 0
corner_radius_top_right = 4
padding_bottom = "pixels((theme.default_padding * 2 * theme.default_base_scale))"
padding_left = "pixels((theme.default_padding * 2 * theme.default_base_scale))"
padding_right = "pixels((theme.default_padding * 2 * theme.default_base_scale))"
padding_top = "pixels((theme.default_padding * 2 * theme.default_base_scale))"
shadow_color = "theme.default_shadow_color"
