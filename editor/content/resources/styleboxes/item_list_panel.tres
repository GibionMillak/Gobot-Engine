padding_right = "pixels((((int(round(theme.default_padding))) * theme.default_base_scale)))"
padding_bottom = "pixels((((int(round(theme.default_padding))) * theme.default_base_scale)))"
border_color = "theme.Editor.colors.dark_color_3"
border_width_left = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
border_width_top = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
border_width_right = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
border_width_bottom = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
