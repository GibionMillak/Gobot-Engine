[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "ItemList panel"
background_color = "theme.Editor.colors.dark_color_1"
border_color = "theme.Editor.colors.dark_color_3"
border_width_bottom = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
border_width_left = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
border_width_right = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
border_width_top = "pixels(int((int(round((theme.default_border_width * max(1, theme.default_base_scale)))))))"
corner_detail = 8
corner_radius_bottom_left = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_bottom_right = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_top_left = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_top_right = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
padding_bottom = "pixels((((int(round(theme.default_padding))) * theme.default_base_scale)))"
padding_left = "pixels((((int(round(theme.default_padding))) * theme.default_base_scale)))"
padding_right = "pixels((((int(round(theme.default_padding))) * theme.default_base_scale)))"
padding_top = "pixels((((int(round(theme.default_padding))) * theme.default_base_scale)))"
shadow_color = "theme.default_shadow_color"
