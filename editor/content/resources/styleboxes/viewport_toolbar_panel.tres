[gd_resource type="StyleBox" format=4]

[resource]
background_color = "(theme.Editor.colors.dark_color_1 * Color(1, 1, 1, 0.8))"
padding_left = "pixels((4 * theme.default_base_scale))"
padding_top = "pixels((4 * theme.default_base_scale))"
padding_right = "pixels((4 * theme.default_base_scale))"
padding_bottom = "pixels((4 * theme.default_base_scale))"
border_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
border_width_left = "pixels(int(round((1 * theme.default_base_scale))))"
border_width_top = "pixels(int(round((1 * theme.default_base_scale))))"
border_width_right = "pixels(int(round((1 * theme.default_base_scale))))"
border_width_bottom = "pixels(int(round((1 * theme.default_base_scale))))"
corner_radius_top_left = "pixels(int((3 * theme.default_base_scale)))"
corner_radius_top_right = "pixels(int((3 * theme.default_base_scale)))"
corner_radius_bottom_right = "pixels(int((3 * theme.default_base_scale)))"
corner_radius_bottom_left = "pixels(int((3 * theme.default_base_scale)))"
corner_detail = "pixels(int(ceil(((0.8 * 3) * theme.default_base_scale))))"
