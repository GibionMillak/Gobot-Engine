[gd_resource type="StyleBox" format=4]

[resource]
background_color = Color(0, 0, 0, 0)
border_color = "theme.Editor.colors.contrast_color_1"
border_width_left = "pixels(int(max(1, (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_top = "pixels(int(max(1, (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_right = "pixels(int(max(1, (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_bottom = "pixels(int(max(1, (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
