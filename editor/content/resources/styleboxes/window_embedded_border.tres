[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "Window embedded_border"
background_color = "theme.default_base_color"
border_color = "theme.Editor.colors.base_color"
border_width_bottom = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_left = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_right = "pixels(round((theme.default_border_width * theme.default_base_scale)))"
border_width_top = "pixels(int(round((24 * theme.default_base_scale))))"
corner_detail = 8
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
expand_margin_top = "pixels(round((24 * theme.default_base_scale)))"
padding_bottom = "pixels(((((int(round(theme.default_padding))) * 2.4) * theme.default_base_scale)))"
padding_left = "pixels(((((int(round(theme.default_padding))) * 2.4) * theme.default_base_scale)))"
padding_right = "pixels(((((int(round(theme.default_padding))) * 2.4) * theme.default_base_scale)))"
padding_top = "pixels(((((int(round(theme.default_padding))) * 2.4) * theme.default_base_scale)))"
shadow_color = "theme.Editor.colors.shadow_color"
shadow_size = "pixels(int(round((4 * theme.default_base_scale))))"
