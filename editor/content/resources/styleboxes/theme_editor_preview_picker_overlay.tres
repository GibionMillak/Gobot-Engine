[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "ThemeEditor preview_picker_overlay"
background_color = "Color((theme.Editor.colors.accent_color).r, (theme.Editor.colors.accent_color).g, (theme.Editor.colors.accent_color).b, 0.2)"
border_color = "theme.Editor.colors.accent_color"
border_width_bottom = "pixels(int(round((1.0 * theme.default_base_scale))))"
border_width_left = "pixels(int(round((1.0 * theme.default_base_scale))))"
border_width_right = "pixels(int(round((1.0 * theme.default_base_scale))))"
border_width_top = "pixels(int(round((1.0 * theme.default_base_scale))))"
corner_detail = 1
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
padding_bottom = 0
padding_left = 0
padding_right = 0
padding_top = 0
shadow_color = Color(0, 0, 0, 0.6)
