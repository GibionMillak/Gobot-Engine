[gd_resource type="StyleBox" format=4]

[resource]
background_color = "theme.Editor.colors.mono_color * Color(1, 1, 1, 0.11)"
padding_left = "pixels(((theme.default_padding * 2 * theme.default_base_scale) + round((theme.default_border_width * theme.default_base_scale))))"
padding_top = "pixels(round((((int(round(theme.default_padding))) + 2) * theme.default_base_scale)))"
padding_right = "pixels(((theme.default_padding * 2 * theme.default_base_scale) + round((theme.default_border_width * theme.default_base_scale))))"
padding_bottom = "pixels(round((((int(round(theme.default_padding))) + 2) * theme.default_base_scale)))"
border_color = Color(0.1155, 0.132, 0.1595, 1)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
