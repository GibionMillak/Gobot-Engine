[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "ItemList cursor"
background_color = Color(0, 0, 0, 0)
border_color = "theme.Editor.colors.highlight_color"
border_width_bottom = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_left = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_right = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_top = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
corner_detail = 8
corner_radius_bottom_left = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_bottom_right = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_top_left = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_top_right = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
padding_bottom = "pixels((theme.default_padding * theme.default_base_scale))"
padding_left = "pixels((theme.default_padding * theme.default_base_scale))"
padding_right = "pixels((theme.default_padding * theme.default_base_scale))"
padding_top = "pixels((theme.default_padding * theme.default_base_scale))"
shadow_color = "theme.default_shadow_color"
