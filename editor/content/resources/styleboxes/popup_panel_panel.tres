[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "PopupPanel panel"
background_color = "theme.default_base_color"
border_color = "theme.Editor.colors.dark_color_2"
border_width_bottom = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_left = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_right = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
border_width_top = "pixels(int(max(round((1 * theme.default_base_scale)), (int(round((theme.default_border_width * max(1, theme.default_base_scale))))))))"
corner_detail = 8
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
padding_bottom = "pixels((2 + round((((int(round(theme.default_padding))) * 1.5) * theme.default_base_scale))))"
padding_left = "pixels((2 + round((((int(round(theme.default_padding))) * 1.5) * theme.default_base_scale))))"
padding_right = "pixels((2 + round((((int(round(theme.default_padding))) * 1.5) * theme.default_base_scale))))"
padding_top = "pixels((2 + round((((int(round(theme.default_padding))) * 1.5) * theme.default_base_scale))))"
shadow_color = "theme.Editor.colors.shadow_color"
shadow_size = "pixels(int(round((4 * theme.default_base_scale))))"
