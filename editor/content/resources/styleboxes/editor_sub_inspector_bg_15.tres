[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "Editor sub_inspector_bg15"
background_color = "(theme.Editor.colors.dark_color_1).lerp(theme.EditorInspector.colors.subresource_color_6, 0.08)"
border_color = "(theme.EditorInspector.colors.subresource_color_6 * Color(0.7, 0.7, 0.7, 0.8))"
border_width_bottom = "pixels(int(round((2 * theme.default_base_scale))))"
border_width_left = "pixels(int(round((2 * theme.default_base_scale))))"
border_width_right = "pixels(int(round((2 * theme.default_base_scale))))"
border_width_top = "pixels(int(round((2 * theme.default_base_scale))))"
corner_detail = 8
corner_radius_bottom_left = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_bottom_right = "pixels(round((theme.default_border_radius * theme.default_base_scale)))"
corner_radius_top_left = 0
corner_radius_top_right = 0
padding_bottom = "pixels(round((4 * theme.default_base_scale)))"
padding_left = "pixels(round((4 * theme.default_base_scale)))"
padding_right = "pixels(round((4 * theme.default_base_scale)))"
padding_top = "pixels(round((4 * theme.default_base_scale)))"
shadow_color = "theme.default_shadow_color"
