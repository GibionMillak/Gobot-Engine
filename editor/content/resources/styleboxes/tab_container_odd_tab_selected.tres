background_color = "theme.Editor.colors.disabled_bg_color"
padding_left = "pixels((round((int(((int(round(theme.default_padding))) * 2)) * theme.default_base_scale)) + round((5 * theme.default_base_scale))))"
padding_top = "pixels(round((int(((int(round(theme.default_padding))) * 2)) * theme.default_base_scale)))"
padding_right = "pixels((round((int(((int(round(theme.default_padding))) * 2)) * theme.default_base_scale)) + round((5 * theme.default_base_scale))))"
padding_bottom = "pixels(round((int(((int(round(theme.default_padding))) * 2)) * theme.default_base_scale)))"
border_color = "(theme.Editor.colors.dark_color_2).lerp(theme.Editor.colors.accent_color, 0.75)"
