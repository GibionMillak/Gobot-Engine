[gd_resource type="StyleBox" format=4]

[resource]
background_color = "(theme.Editor.colors.dark_color_2).lerp(theme.Editor.colors.dark_color_3, 0.15)"
padding_left = "pixels(round((2 * theme.default_base_scale)))"
padding_top = "pixels(round((2 * theme.default_base_scale)))"
padding_right = "pixels(round((2 * theme.default_base_scale)))"
padding_bottom = "pixels(round((2 * theme.default_base_scale)))"
border_color = "theme.default_base_color"
