[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "Color Picker Focus Circle"
padding_left = "theme.default_padding * 2"
padding_top = "theme.default_padding * 2"
padding_right = "theme.default_padding * 2"
padding_bottom = "theme.default_padding * 2"
background_color = Color(0, 0, 0, 0)
border_color = "theme.default_accent_color"
border_width_left = "theme.default_focus_border_width"
border_width_top = "theme.default_focus_border_width"
border_width_right = "theme.default_focus_border_width"
border_width_bottom = "theme.default_focus_border_width"
corner_radius_top_left = "theme.Editor.constants.focus_circle_radius"
corner_radius_top_right = "theme.Editor.constants.focus_circle_radius"
corner_radius_bottom_right = "theme.Editor.constants.focus_circle_radius"
corner_radius_bottom_left = "theme.Editor.constants.focus_circle_radius"
corner_detail = "theme.Editor.constants.focus_circle_detail"
