[gd_resource type="StyleBox" format=4]

[resource]
resource_name = "TooltipPanel panel"
background_color = "(theme.Editor.colors.dark_color_3 * Color(0.8, 0.8, 0.8, 0.9))"
border_color = "theme.Editor.colors.contrast_color_1"
