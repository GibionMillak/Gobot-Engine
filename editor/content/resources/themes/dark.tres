[resource]
default_font_family = ExtResource("font_baloo_2_regular")
default_font_size = 16
default_base_color = Color(0.1255, 0.1373, 0.149, 1)
default_accent_color = Color(0.239, 0.682, 0.914, 1)
default_contrast = 0.3
default_icon_saturation = 2.0
default_padding = 4.0
default_border_width = 0.0
default_border_radius = 4.0
default_base_scale = 1.0

AnimationBezierTrackEdit/colors/focus_color = "(theme.Editor.colors.accent_color * Color(1, 1, 1, 0.7))"
AnimationBezierTrackEdit/colors/h_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationBezierTrackEdit/colors/track_focus_color = "(theme.Editor.colors.accent_color * Color(1, 1, 1, 0.5))"
AnimationBezierTrackEdit/colors/v_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationBezierTrackEdit/constants/h_separation = "int(round((((int(round(theme.default_padding))) + 2) * theme.default_base_scale)))"
AnimationBezierTrackEdit/constants/v_separation = "int(round((((((int(round(theme.default_padding))) + 6) + (((int(round(theme.default_padding))) + 6) % 2))) * theme.default_base_scale)))"

AnimationTimelineEdit/colors/font_primary_color = "theme.Editor.colors.font_normal_color"
AnimationTimelineEdit/colors/font_secondary_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.5))"
AnimationTimelineEdit/colors/h_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationTimelineEdit/colors/v_line_primary_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationTimelineEdit/colors/v_line_secondary_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationTimelineEdit/constants/text_primary_margin = "int(round((3 * theme.default_base_scale)))"
AnimationTimelineEdit/constants/text_secondary_margin = "int(round((3 * theme.default_base_scale)))"
AnimationTimelineEdit/constants/v_line_primary_margin = 0
AnimationTimelineEdit/constants/v_line_primary_width = "int(round((1 * theme.default_base_scale)))"
AnimationTimelineEdit/constants/v_line_secondary_margin = 0
AnimationTimelineEdit/constants/v_line_secondary_width = "int(round((1 * theme.default_base_scale)))"
AnimationTimelineEdit/styles/time_available = ExtResource("stylebox_animation_timeline_edit_time_available")
AnimationTimelineEdit/styles/time_unavailable = ExtResource("stylebox_animation_timeline_edit_time_unavailable")

AnimationTrackEdit/colors/h_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationTrackEdit/constants/h_separation = "int(round((((int(round(theme.default_padding))) + 2) * theme.default_base_scale)))"
AnimationTrackEdit/constants/outer_margin = "int(round((((int(round(theme.default_padding))) * 6) * theme.default_base_scale)))"
AnimationTrackEdit/styles/focus = ExtResource("stylebox_button_focus")
AnimationTrackEdit/styles/hover = ExtResource("stylebox_animation_track_edit_hover")
AnimationTrackEdit/styles/odd = ExtResource("stylebox_animation_track_edit_odd")

AnimationTrackEditGroup/colors/h_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationTrackEditGroup/colors/v_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationTrackEditGroup/constants/h_separation = "int(round((((int(round(theme.default_padding))) + 2) * theme.default_base_scale)))"
AnimationTrackEditGroup/constants/v_separation = 0
AnimationTrackEditGroup/styles/header = ExtResource("stylebox_animation_track_edit_group_header")
AnimationTrackEditGroup/styles/hover = ExtResource("stylebox_animation_track_edit_group_hover")

AnimationTrackEditor/constants/timeline_v_separation = 0
AnimationTrackEditor/constants/track_v_separation = 0

BaseButton/constants/click_margin = "(int(int(round((2 * theme.default_base_scale)))))"

BoxContainer/constants/separation = "int((((int(round(theme.default_padding))) * theme.default_base_scale)))"

Button/colors/font_normal_color = "theme.Editor.colors.font_normal_color"
Button/colors/font_disabled_color = "theme.Editor.colors.font_disabled_color"
Button/colors/font_focus_color = "theme.Editor.colors.font_focus_color"
Button/colors/font_hover_color = "theme.Editor.colors.font_hover_color"
