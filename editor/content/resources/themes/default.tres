resource_name = "Default"
default_font_family = ExtResource("1_font")
default_font_size = 16
default_base_color = Color(0.21, 0.24, 0.29, 1)
default_accent_color = Color(0.44, 0.73, 0.98, 1)
default_contrast = 0.3
default_icon_saturation = 1.0
default_padding = 4.0
default_border_width = 0.0
default_border_radius = 4.0
default_focus_border_width = 2.0
default_shadow_color = Color(0, 0, 0, 0.6)
default_base_scale = 1.0
default_background_color = "theme.default_base_color.lerp(Color(0, 0, 0, 1), theme.default_contrast).clamp()"
default_border_color = "theme.default_base_color.lerp(Color(0, 0, 0, 1), theme.default_contrast * 1.5).clamp()"
AnimationBezierTrackEdit/colors/focus_color = "(theme.Editor.colors.accent_color * Color(1, 1, 1, 0.7))"
AnimationBezierTrackEdit/colors/h_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationBezierTrackEdit/colors/track_focus_color = "(theme.Editor.colors.accent_color * Color(1, 1, 1, 0.5))"
AnimationBezierTrackEdit/colors/v_line_color = "(theme.Editor.colors.font_normal_color * Color(1, 1, 1, 0.2))"
AnimationBezierTrackEdit/constants/h_separation = "int(round((((int(round(theme.default_padding))) + 2) * theme.default_base_scale)))"
